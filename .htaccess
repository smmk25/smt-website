# Salman Mohammad Transport — Apache / LiteSpeed config (cPanel)

RewriteEngine On

# The homepage lives at "/" — old addresses redirect there permanently,
# so any links or rankings they built up pass to the one canonical URL
RewriteRule ^index-scroll\.html$ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# Page speed is a ranking factor: compress text assets...
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/xml image/svg+xml application/manifest+json
</IfModule>

# ...and let browsers cache the heavy ones
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
