{
  "name": "SMT — Website Quote Requests",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smt-quote",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://yourdomain.com"
        }
      },
      "id": "webhook-in",
      "name": "Website Quote Form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -220,
        300
      ],
      "webhookId": "smt-quote-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Normalise + guard the incoming payload before it goes anywhere.\nconst b = $input.first().json.body || $input.first().json;\n\nconst clean = (v, max = 2000) =>\n  String(v ?? '').trim().slice(0, max);\n\n// Reject if the honeypot was filled, or required fields are missing.\nif (clean(b.website)) {\n  return [{ json: { spam: true, reason: 'honeypot' } }];\n}\n\nconst required = ['service', 'company', 'contact_name', 'phone', 'email', 'description'];\nconst missing = required.filter((k) => !clean(b[k]));\nif (missing.length) {\n  return [{ json: { spam: true, reason: 'missing:' + missing.join(',') } }];\n}\n\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(clean(b.email));\nif (!emailOk) {\n  return [{ json: { spam: true, reason: 'bad-email' } }];\n}\n\nconst frequency = clean(b.frequency) || 'Not specified';\nconst isContract = /month|recur|contract/i.test(frequency);\n\nreturn [{\n  json: {\n    spam: false,\n    frequency,\n    isContract,\n    priority: isContract ? 'Contract enquiry — call to discuss' : 'One-time job',\n    service: clean(b.service, 120),\n    company: clean(b.company, 200),\n    contact_name: clean(b.contact_name, 200),\n    phone: clean(b.phone, 60),\n    email: clean(b.email, 200),\n    description: clean(b.description, 4000),\n    submitted_at: clean(b.submitted_at, 60) || new Date().toISOString(),\n    received_at: new Date().toISOString(),\n    source: clean(b.source, 200)\n  }\n}];"
      },
      "id": "normalise",
      "name": "Validate & Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.spam }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-legit",
      "name": "Legitimate Enquiry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "info@salmanmohammadtransport.ae",
        "toEmail": "sales@salmanmohammadtransport.ae",
        "subject": "={{ $json.isContract ? '[CONTRACT] ' : '[ONE-TIME] ' }}Quote request — {{ $json.company }} ({{ $json.service }})",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:600px;margin:0 auto;border:1px solid #e2e6e9\">\n  <div style=\"background:#eef1f3;padding:24px 20px;text-align:center\">\n    <img src=\"https://salmanmohammadtransport.ae/assets/email-logo.png\" width=\"180\" alt=\"SMT\" style=\"display:inline-block;width:180px;max-width:180px;height:auto;border:0\" />\n  </div>\n  <div style=\"background:#54697A;color:#fff;padding:16px 20px\">\n    <h2 style=\"margin:0;font-size:18px\">New Quote Request</h2>\n    <div style=\"opacity:.9;font-size:13px;margin-top:4px\">{{ $json.priority }}</div>\n  </div>\n  <table cellpadding=\"10\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;font-size:14px\">\n    <tr style=\"background:#f6f7f8\"><td width=\"150\"><b>Service</b></td><td>{{ $json.service }}</td></tr>\n    <tr><td><b>Type</b></td><td>{{ $json.frequency }}</td></tr>\n    <tr style=\"background:#f6f7f8\"><td><b>Company</b></td><td>{{ $json.company }}</td></tr>\n    <tr><td><b>Contact</b></td><td>{{ $json.contact_name }}</td></tr>\n    <tr style=\"background:#f6f7f8\"><td><b>Phone</b></td><td><a href=\"tel:{{ $json.phone }}\" style=\"color:#54697A\">{{ $json.phone }}</a></td></tr>\n    <tr><td><b>Email</b></td><td><a href=\"mailto:{{ $json.email }}\" style=\"color:#54697A\">{{ $json.email }}</a></td></tr>\n    <tr style=\"background:#f6f7f8\"><td valign=\"top\"><b>Details</b></td><td>{{ $json.description }}</td></tr>\n    <tr><td><b>Received</b></td><td>{{ $json.received_at }}</td></tr>\n  </table>\n  <div style=\"padding:14px 20px;background:#111;color:#888;font-size:12px\">\n    Sent automatically from {{ $json.source }}\n  </div>\n</div>",
        "options": {
          "replyTo": "={{ $json.email }}"
        }
      },
      "id": "send-email",
      "name": "Email Sales Team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        460,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "https://yourdomain.com"
              }
            ]
          }
        }
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      },
      "id": "respond-spam",
      "name": "Respond (Spam Ignored)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        460,
        560
      ]
    }
  ],
  "connections": {
    "Website Quote Form": {
      "main": [
        [
          {
            "node": "Validate & Normalise",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Normalise": {
      "main": [
        [
          {
            "node": "Legitimate Enquiry?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Legitimate Enquiry?": {
      "main": [
        [
          {
            "node": "Email Sales Team",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond (Spam Ignored)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Sales Team": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
